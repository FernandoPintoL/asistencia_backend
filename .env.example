# Copia este archivo como .env y completa tus valores. El .env NO se sube a git.

# Genera una con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
# En producción: el dominio del backend, ej. mi-api.onrender.com
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=asistencia_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Dominio(s) del frontend separados por coma. En producción, ej. https://mi-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Duración de la sesión (token JWT) en horas
JWT_HORAS=8
